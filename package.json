{
  "name": "dsh-shorekeeper",
  "description": "B站 400+ 收藏的守岸人桌宠，现在来陪你了。《鸣潮》的守岸人陪你工作，也陪你等待。任务中换表情，完成后用熟悉的语音回应；支持摸头互动、自选表情与语音台词。适用于 Windows x64 本机 DeepSeek Harness，首次下载约 229 MiB 完整程序。",
  "version": "1.2.7",
  "author": "Doya16",
  "homepage": "https://github.com/Doya16/dsh-shorekeeper#readme",
  "bugs": {
    "url": "https://github.com/Doya16/dsh-shorekeeper/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "icon": "./icon.png",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "icon.png",
    "locale/*.json",
    "runtime-manifest.json",
    "tools/extract-runtime.ps1",
    "CREDITS.txt"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "shorekeeper",
    "desktop-pet",
    "wuthering-waves"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doya16/dsh-shorekeeper.git"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "verify:publish": "node tools/verify-npm-source.mjs",
    "prepublishOnly": "node tools/verify-npm-source.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
